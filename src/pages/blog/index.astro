---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

// Índice automático del blog: añade un objeto por cada artículo.
// Si cambias el título de un artículo, actualízalo también aquí.
// Las rutas se escriben sin la barra inicial: se les añade BASE_URL al renderizar.
const articulos = [
  {
    title: '5 consejos para proteger los datos de tu empresa',
    href: 'blog/articulo-1/',
    description: 'La seguridad informática no es solo cosa de grandes empresas. Usar contraseñas seguras, activar la verificación en dos pasos, hacer copias de seguridad periódicas, mantener los programas actualizados y desconfiar de los correos sospechosos son medidas sencillas que evitan la mayoría de los problemas.',
  },
  {
    title: '¿Por qué tu negocio necesita una página web?',
    href: 'blog/articulo-2/',
    description: 'Hoy en día, la mayoría de los clientes buscan en internet antes de contratar un servicio. Una página web da confianza, muestra lo que ofreces y permite que te encuentren las 24 horas del día. Además, es mucho más económica que otras formas de publicidad.',
  },
];
---

<BaseLayout title="Blog | TecnoRed Soluciones" description="Artículos y consejos sobre tecnología, seguridad y presencia online para tu negocio.">
  <h1>TecnoRed Soluciones</h1>

  <ul>
    {articulos.map((articulo) => (
      <li>
        <a href={`${base}${articulo.href}`}>{articulo.title}</a>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
